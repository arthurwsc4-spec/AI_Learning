def back_propagation(inputs, outputs, expected_values, learn_rate):
  dw = learn_rate * (-2 * inputs * (expected_values - outputs)).mean() #derivative weight
  db = learn_rate * (-2 * (expected_values - outputs)).mean() #derivative weight
  
  w -= dw #updating weight
  b -= db #updating bias
